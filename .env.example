RUST_LOG="info,yoni2=debug"

PREFIX="yoni"

# The default language to be used in the bot.
DEFAULT_LANG=es-ES
# The token discord provides for your bot that is running this software.
BOT_TOKEN=discord-token
# The url to connect to the database Yoni will use.
DATABASE_URL="sqlite://yoni.db"

CHANNEL_BUGS_ID=0000000000000000000
CHANNEL_COMANDOS_ID=0000000000000000000
CHANNEL_HILOS_ID=0000000000000000000
CHANNEL_ORATORIO_ID=0000000000000000000
CHANNEL_YONI_ID=0000000000000000000

USER_YONI_ID=0000000000000000000
USER_MIKE_ID=0000000000000000000
USER_MONAKA_ID=0000000000000000000

ROLE_ADMIN_ID=0000000000000000000
ROLE_MOD_ID=0000000000000000000